<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="108dp" android:height="108dp" />
            <solid android:color="#E8EFE0" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:width="80dp" android:height="80dp" android:gravity="center">
        <bitmap android:src="@drawable/garden_sprout" android:gravity="fill"
            android:filter="true" android:mipMap="true" />
    </item>
</layer-list>
